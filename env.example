# --- WV Education News Desk — self-hosted (Docker) configuration ---
# Copy to `.env` (install.sh does this automatically) and fill in real values.
# docker-compose reads this file. NEVER commit the real .env.

# ---- Core ----
DB_NAME=wvedtalk
# Host port the site is served on (nginx in the frontend container).
HTTP_PORT=80
# Public base URL of this deployment — used in outgoing email links + share pages.
# This also decides whether the login cookie is marked Secure: an http:// URL => not Secure
# (required for a local/HTTP install, or the browser drops the cookie and login never sticks),
# an https:// URL => Secure. Set COOKIE_SECURE=true/false below to override.
APP_URL=http://localhost
# COOKIE_SECURE=  # leave blank to infer from APP_URL; set true only when served over HTTPS
# Comma-separated allowed browser origins (no wildcard when cookies are used).
CORS_ORIGINS=http://localhost

# REQUIRED. Signs session cookies + share tokens and derives the secret-encryption key.
# install.sh auto-generates one if left blank. Generate manually with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Machine credential for downstream X-Desk-Passcode access. OPTIONAL — leave blank
# to disable programmatic/service access entirely (human logins are unaffected).
# Only set this if a downstream automation needs to read the API without logging in.
APP_PASSCODE=

# =====================================================================
# TARGET self-hosted keys (used after the Phase 2–5 code migration;
# also what the in-app Settings → Integrations panel will manage).
# =====================================================================

# ---- LLM (configurable) ----
# LLM_PROVIDER: gemini | openai
LLM_PROVIDER=gemini
# Gemini (default) — Google AI Studio API key, with Google Search grounding.
GEMINI_API_KEY=
# OpenAI (optional alternative) — used when LLM_PROVIDER=openai.
OPENAI_API_KEY=
# Optional model override (blank = provider default).
LLM_MODEL=

# ---- Email: Resend (default) with SMTP fallback ----
# EMAIL_PROVIDER: resend | smtp
EMAIL_PROVIDER=resend
EMAIL_FROM=news@yourdomain.com
EMAIL_FROM_NAME=WV Education News Desk
EMAIL_REPLY_TO=
# Resend (default)
RESEND_API_KEY=
# SMTP fallback (used when Resend is unset or a Resend send fails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# ---- Cloudflare Turnstile (optional CAPTCHA on the public submit form) ----
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# =====================================================================
# CURRENT build (pre-migration) keys.
# The code shipped TODAY still uses Emergent's managed LLM + email. To run
# this Docker stack before the Phase 2–5 migration lands, set these two.
# They are removed from the app in Phase 5 (hard cut).
# =====================================================================
EMERGENT_LLM_KEY=
EMERGENT_EMAIL_KEY=
