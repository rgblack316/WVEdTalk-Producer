# Backend environment — copy to `backend/.env` and fill in real values.
# NEVER commit the real .env. Values below are placeholders/examples.
#
# Self-hosted edition: there is NO Emergent dependency. AI + email credentials are normally
# managed in-app (Settings → Integrations) and stored encrypted in the database; the values here
# act only as an initial fallback before anything is configured in the UI.

# --- MongoDB ---
MONGO_URL="mongodb://localhost:27017"
DB_NAME="wvedtalk"

# --- CORS / app URL ---
CORS_ORIGINS="http://localhost:3000"
APP_URL="http://localhost:3000"

# --- Auth ---
# REQUIRED. Signs session cookies + share tokens AND derives the integration-secret
# encryption key. The server refuses to boot without it. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET="replace-with-a-64-char-hex-secret"
# OPTIONAL machine credential for the X-Desk-Passcode header. Leave blank to disable
# programmatic/service access entirely (human logins are unaffected).
APP_PASSCODE=""

# --- AI / Research model (configurable; normally set in Settings → Integrations) ---
# LLM_PROVIDER: gemini | openai
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
# Optional model override (blank = provider default: gemini-2.5-pro / gpt-4o-search-preview)
LLM_MODEL=""

# --- Email: Resend (default) with SMTP fallback (normally set in Settings → Integrations) ---
EMAIL_PROVIDER="resend"
EMAIL_FROM="news@yourdomain.com"
EMAIL_FROM_NAME="WV Education News Desk"
EMAIL_REPLY_TO=""
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_STARTTLS="true"

# --- Cloudflare Turnstile (optional CAPTCHA; also editable in Settings → Integrations) ---
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
